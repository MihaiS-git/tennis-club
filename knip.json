{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/lib/db/migrations/*.ts",
    "scripts/initialize-test-database.ts",
    "playwright.config.ts",
    "playwright.stripe-live.config.ts",
    "tests/local/assert-next-server-environment.mjs",
    "tests/local/runner-lock-helper.mjs",
    "tests/e2e/fixtures/stripe-server.mjs",
    "tests/e2e/recovery-verification.config.ts",
    "tests/e2e-live/**/*.e2e.ts",
    "tests/e2e-live/dev-server.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx,mjs,css}",
    "scripts/*.{ts,mjs}",
    "tests/**/*.{ts,tsx,mjs}"
  ],
  "vitest": {
    "entry": [
      "tests/{unit,components,integration}/**/*.test.{ts,tsx}"
    ]
  },
  "playwright": {
    "config": [],
    "entry": [
      "tests/e2e/**/*.e2e.ts"
    ]
  },
  "ignoreDependencies": [
    "@next/env"
  ],
  "ignoreBinaries": [
    "psql",
    "stripe"
  ]
}
