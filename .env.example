SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Local seed/test tooling only; production application uses Auth + Storage.
SUPABASE_SECRET_KEY=your-local-tooling-supabase-secret-key
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Server-only TypeORM connection for application persistence.
DATABASE_URL=
# Positive integer; unset or empty defaults to 2 connections per process.
DATABASE_POOL_MAX=
# Independent provider configuration. Credentials are server-only.
# Active provider is explicitly selected in Admin → Payments; default is none.
STRIPE_SECRET_KEY=
# Browser-safe key passed only to Stripe Elements; must match secret key mode.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NETOPIA_API_KEY=
NETOPIA_POS_SIGNATURE=
NETOPIA_ENVIRONMENT=

# Server-only booking notifications; independent of Supabase Auth email.
# Brevo transactional API key. Required by the delivery endpoint.
BREVO_API_KEY=
# Sender email/name and the delivery switch are saved in Admin → Club.
# Manual local development and production use live Brevo delivery. Isolated test runners force sandbox.
NOTIFICATION_EMAIL_MODE=live
# Optional UTC cutoff for old pending rows when switching a local database from sandbox to live.
# Example: 2026-10-22T17:30:57.290Z. Rows before this time stay pending and are never auto-sent.
NOTIFICATION_DELIVERY_NOT_BEFORE=
# Dedicated server-to-server bearer secret; generate a random value of 32+ characters.
NOTIFICATION_CRON_SECRET=
# Brevo transactional webhook Bearer token; use a separate random value.
BREVO_WEBHOOK_SECRET=
# Full endpoint reachable from the database (local: http://host.docker.internal:3000/api/notifications/deliver).
NOTIFICATION_CRON_URL=
# Optional direct postgres connection for Cron setup; empty uses DATABASE_URL.
# Must match SUPABASE_URL. Local setup verifies the tennis-club development container.
CRON_DATABASE_URL=
