SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Local seed/test tooling only; production application uses Auth + Storage.
SUPABASE_SECRET_KEY=your-local-tooling-supabase-secret-key
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Server-only TypeORM connection for application persistence.
DATABASE_URL=
# Positive integer; unset or empty defaults to 2 connections per process.
DATABASE_POOL_MAX=
# Independent provider configuration. Credentials are server-only.
# Active provider is explicitly selected in Admin → Payments; default is none.
STRIPE_SECRET_KEY=
# Browser-safe key passed only to Stripe Elements; must match secret key mode.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NETOPIA_API_KEY=
NETOPIA_POS_SIGNATURE=
NETOPIA_ENVIRONMENT=

# Server-only booking notifications; independent of Supabase Auth email.
BREVO_API_KEY=
# A sender email verified in Brevo.
BOOKING_MAIL_FROM=
