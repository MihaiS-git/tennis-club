SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Independent provider configuration. Credentials are server-only.
# Active provider is explicitly selected in Admin → Payments; default is none.
STRIPE_SECRET_KEY=
# Browser-safe key passed only to Stripe Elements; must match secret key mode.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NETOPIA_API_KEY=
NETOPIA_POS_SIGNATURE=
NETOPIA_ENVIRONMENT=

# Server-only booking notifications; independent of Supabase Auth email.
BOOKING_MAIL_FROM=bookings@tennis-club.test
BOOKING_SMTP_HOST=127.0.0.1
BOOKING_SMTP_PORT=54325
BOOKING_SMTP_SECURE=false
# Optional SMTP credentials (leave unset for local Mailpit).
# BOOKING_SMTP_USER=
# BOOKING_SMTP_PASSWORD=
